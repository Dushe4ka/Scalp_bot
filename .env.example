# -----------------------------
# Bybit API keys
# -----------------------------
API_KEY=your_mainnet_api_key
API_SECRET=your_mainnet_api_secret
DEMO_API_KEY=your_demo_api_key
DEMO_API_SECRET=your_demo_api_secret

# -----------------------------
# Trading (common)
# -----------------------------
SYMBOL=BTCUSDT
USDT_AMOUNT=10
USE_DEMO=False
# Рекомендуемая сумма сделки: % от futures-баланса (1.75 = 1,75%)
RECOMMENDED_TRADE_AMOUNT_PERCENT=1.75
# Стоимость подписки на 1 месяц (USD)
SUBSCRIPTION_PRICE_USD=79
MARGIN_MODE=CROSS
POSITION_SIDE=Sell
LEVERAGE=10

# BU / SL / trailing
TRIGGER_PERCENTAGE=3
TRIGGER_TS_PERCENTAGE=1.0
STOP_LOSS_PERCENTAGE=40.0
CORRECTION_SL_PERCENTAGE=0.5
PNL_LOG_INTERVAL=5

# DCA limits for short_bu_ts_limit
LIMIT_PERCENTAGE=10.0
COUNT_LIMIT_ORDERS=3
# БУ после N-го усреднения (multiuser engine)
BREAKEVEN_AFTER_AVERAGING_COUNT=4
TRIGGER_PERCENTAGE_AFTER_AVERAGING=1.0

# Separate amounts for nomulti algorithms
SHORT_BU_TS_LIMIT_USDT_AMOUNT=10
HEDGE_USDT_AMOUNT=100

# -----------------------------
# Server / Celery
# -----------------------------
LOCAL_SERVER_URL=http://127.0.0.1:8050
SERVER_URL=https://your-public-url.example.com
REDIS_URL=redis://:password@127.0.0.1:6379/0
RESULT_BACKEND=redis://:password@127.0.0.1:6379/0
# Автоперезапуск uvicorn при изменении файлов — только для локальной разработки.
# На проде НЕ включать: StatReload поллит mtime каждого файла в рабочей директории
# (включая myvenv/) несколько раз в секунду — паразитная нагрузка CPU без единого запроса.
UVICORN_RELOAD=false

# Phase 2: price feed + engine sharding
TRADE_ENGINE_COUNT=2
MAX_SESSIONS_PER_ENGINE=30
# CELERY_ENGINE_ID=0   # только на процессе celery worker -Q trade_engine_N
PRICE_FEED_REDIS_ENABLED=true
PRICE_FEED_LOCAL_FALLBACK=true
PRICE_FEED_STALE_SEC=5
PRICE_FEED_DOWN_SEC=15
PRICE_FEED_FAILOVER_HYSTERESIS_SEC=30
FEED_STALE_SEC=5
FEED_DOWN_SEC=15
TRADE_SUBMIT_STAGGER_SEC=0.03
# WS по символу открывается при сигнале (market:feed:ensure), не при старте feed
MARKET_FEED_SYMBOL_IDLE_SEC=3600
NOMULTI_TG_ID=
NOMULTI_USER_NAME=nomulti
FORCE_LINEAR_ONE_WAY=true
CELERY_SUBSCRIBERS_BOT_TOKEN=

# Периодическая проверка подписок (Celery Beat), интервал в часах
SUBSCRIPTION_LIFECYCLE_CHECK_HOURS=12

# -----------------------------
# Demo-показ сделок для маркетинга (изолированный Celery-воркер, свой demo Bybit аккаунт)
# -----------------------------
# ВАЖНО: DEMO_SHOWCASE_TG_ID не должен быть активным реальным trading candidate одновременно
# (см. предупреждение в demo_showcase/config.py)
DEMO_SHOWCASE_ENABLED=false
DEMO_SHOWCASE_TG_ID=490882969
DEMO_SHOWCASE_NAME=demo_showcase
DEMO_SHOWCASE_API_KEY=
DEMO_SHOWCASE_API_SECRET=
DEMO_SHOWCASE_USDT_AMOUNT=5000

# -----------------------------
# Telegram
# -----------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TEST_TELEGRAM_BOT_TOKEN=your_test_telegram_bot_token
URL_TGCHANNEL=https://t.me/your_channel
URL_PAYMENT=TWuu1YRatdhMWWxU5cow5Dye9vuQnbRuuK
# Доступ к /admin и админ-уведомления (один или несколько ID через запятую)
# При старте бота ID автоматически добавляются в app_settings.trade_amount_unlimited_tg_ids
ADMIN_IDS=123456789,987654321,7447565765
# Компактные уведомления о сделке (без "Сумма" при запуске, % вместо PnL при закрытии)
COMPACT_NOTIFY_TG_IDS=
URL_TECH_SUPPORT=https://t.me/your_support
TECH_SUPPORT_ID=123456789

# -----------------------------
# MongoDB
# -----------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=scalp_bot

# Legacy aliases (also supported by config.py):
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=scalp_bot
